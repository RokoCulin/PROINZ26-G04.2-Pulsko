' ==============================================================================
' 3-1-pulsko-system-UC.puml
'
' Svrha:    Prikazuje tko i s kojim ciljem koristi sustav Pulsko (pacijenti,
'           liječnici, administrator) te koje vanjske sustave sustav koristi.
'           Obrasci uporabe grupirani su u skupine UC-1 do UC-8 (okviri), a
'           UC-9 i UC-10 stoje samostalno.
' Autor:    Roko, tim G04.2
' AI:       Autor je naveo aktere, obrasce uporabe i njihove odnose; AI je korišten kao pomoć za lakše pisanje PlantUML koda i komentara.
' Zahtjevi: F-001 do F-020 (obrasci uporabe UC-1 do UC-10)
'
' Diagram level: System Requirements
' Diagram type:  Use Case Diagram
' Version:       2.0 (status: K)
' Promjene 2.0: dodan akter Administrator i UC-10 (F-019); skupine UC-1 do UC-8
'               prikazane kao okviri umjesto apstraktnih obrazaca s poopćenjem;
'               uklonjeni UC-3.1, UC-5.3.1 i UC-5.3.2; AI usluga povezana s
'               UC-1.2.1; UC-4.4 preimenovan; raspored lijevo-desno (primarni
'               akteri lijevo, vanjski sustavi desno).
' Ispravak #65: Timer prikazan kao vanjska usluga desno; uklonjena izravna
'               veza liječnika s UC-6.2 (proširenje UC-6.1).
' Raspored u SVG-u zadržan je iz izvornika. Generator provjerava njegov
' ugrađeni PlantUML izvor; ovaj dijagram uređuje se zajedno sa SVG-om.
' ==============================================================================
@startuml
title uc UCD-1 Sustav Pulsko – obrasci uporabe (v2.0, K)
left to right direction
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #495057
skinparam packageStyle rectangle
skinparam actor {
    BackgroundColor #F8F9FA
    BorderColor #212529
    BackgroundColor<<external system>> #FFF3CD
    BorderColor<<external system>> #856404
}
skinparam usecase {
    BackgroundColor #E7F1FF
    BorderColor #0D6EFD
    BackgroundColor<<abstract>> #F1F3F5
    BorderColor<<abstract>> #868E96
}
skinparam rectangle {
    BorderColor #ADB5BD
    FontColor #495057
}
skinparam rectangle {
    BackgroundColor #FAFBFC
    BorderColor #ADB5BD
    FontColor #495057
    FontStyle bold
}
actor "Korisnik" as User
actor "Pacijent" as Patient
actor "Liječnik" as Doctor
actor "Administrator" as Admin
User <|-- Patient
User <|-- Doctor
User <|-- Admin

rectangle "Sustav Pulsko" {
  usecase "UC-9 Prijava u sustav" as UC_SignIn
  rectangle "UC-1 Upravljanje zdravstvenim podacima" {
    usecase "UC-1.1 Unos dnevnog check-ina" as UC_CheckIn
    usecase "UC-1.2 Predaja laboratorijskih nalaza" as UC_LabResult
    usecase "UC-1.2.1 Izdvajanje\nlaboratorijskih vrijednosti" as UC_ExtractLab
    usecase "UC-1.3 Pregled zdravstvenih podataka" as UC_ViewMedData
    usecase "UC-1.4 Pregled trendova i grafova" as UC_ViewGraph
  }
  rectangle "UC-2 Komunikacija i podrška" {
    usecase "UC-2.1 Razgovor s AI agentom" as UC_MessageAI
    usecase "UC-2.2 Razmjena poruka s liječnikom" as UC_Messages
  }
  rectangle "UC-3 Povezivanje s liječnikom" {
    usecase "UC-3.2 Slanje zahtjeva za povezivanje" as UC_SendRequest
    usecase "UC-3.3 Pregled statusa zahtjeva" as UC_ViewRequestStatus
  }
  rectangle "UC-4 Praćenje terapije i termina" {
    usecase "UC-4.1 Evidentiranje uzimanja lijeka" as UC_LogMedication
    usecase "UC-4.2 Pregled rasporeda terapije" as UC_ViewTherapy
    usecase "UC-4.3 Pregled termina pregleda" as UC_ViewAppointments
    usecase "UC-4.4 Primanje podsjetnika" as UC_Reminder
  }
  rectangle "UC-5 Upravljanje pacijentima" {
    usecase "UC-5.1 Pregled povezanih pacijenata" as UC_ViewPatients
    usecase "UC-5.2 Pregled zdravstvenog\nprofila pacijenta" as UC_ViewPatientProfile
    usecase "UC-5.3 Obrada zahtjeva za povezivanje" as UC_HandleRequest
  }
  rectangle "UC-6 Obrada zdravstvenih podataka" {
    usecase "UC-6.1 Potvrda\nlaboratorijskih vrijednosti" as UC_ConfirmLab
    usecase "UC-6.2 Ispravljanje\nlaboratorijskih vrijednosti" as UC_CorrectLab
    usecase "UC-6.3 Pregled zdravstvenih trendova" as UC_ViewPatientTrends
    usecase "UC-6.4 Generiranje AI sažetka" as UC_GenerateAISummary
  }
  rectangle "UC-7 Upravljanje terapijom" {
    usecase "UC-7.1 Određivanje terapije" as UC_SetTherapy
    usecase "UC-7.2 Upravljanje rasporedom terapije" as UC_ManageTherapy
  }
  rectangle "UC-8 Upravljanje terminima" {
    usecase "UC-8.1 Zakazivanje termina" as UC_ScheduleAppointment
    usecase "UC-8.2 Upravljanje postojećim terminima" as UC_ManageAppointments
  }
  usecase "UC-10 Odobravanje liječničkog računa" as UC_ApproveDoctor
}
actor "Pružatelj identiteta\n(OAuth 2.0)" as IdP <<external system>>
actor "AI usluga" as AI <<external system>>
actor "Usluga e-pošte" as Email <<external system>>
actor "Timer" as Timer <<external system>>

User -- UC_SignIn
Patient -- UC_CheckIn
Patient -- UC_LabResult
Patient -- UC_ViewMedData
Patient -- UC_ViewGraph
Patient -- UC_MessageAI
Patient -- UC_Messages
Patient -- UC_SendRequest
Patient -- UC_ViewRequestStatus
Patient -- UC_LogMedication
Patient -- UC_ViewTherapy
Patient -- UC_ViewAppointments
Patient -- UC_Reminder
Doctor -- UC_Messages
Doctor -- UC_ViewPatients
Doctor -- UC_ViewPatientProfile
Doctor -- UC_HandleRequest
Doctor -- UC_ConfirmLab
Doctor -- UC_ViewPatientTrends
Doctor -- UC_GenerateAISummary
Doctor -- UC_SetTherapy
Doctor -- UC_ManageTherapy
Doctor -- UC_ScheduleAppointment
Doctor -- UC_ManageAppointments
Admin -- UC_ApproveDoctor

UC_LabResult ..> UC_ExtractLab : <<include>>
UC_ConfirmLab <.. UC_CorrectLab : <<extend>>

UC_SignIn -- IdP
UC_ExtractLab -- AI
UC_MessageAI -- AI
UC_GenerateAISummary -- AI
UC_Reminder -- Email
' Dulja veza smješta Timer desno od granice sustava.
UC_Reminder --- Timer
@enduml
