' ==============================================================================
' 3-1-pulsko-system-UC.puml
'
' Svrha:    Prikazuje tko i s kojim ciljem koristi sustav Pulsko (pacijenti,
'           liječnici, administrator) te koje vanjske sustave sustav koristi.
'           Interna logika, pohrana podataka i korisničko sučelje namjerno
'           nisu obuhvaćeni.
' Autor:    Roko, tim G04.2
' AI:       Autor je naveo aktere, obrasce uporabe i njihove odnose; AI je korišten kao pomoć za lakše pisanje PlantUML koda i komentara.
' Zahtjevi: UC-001 do UC-017
'
' Diagram level: System Requirements
' Diagram type:  Use Case Diagram
' Version:       1.0 (status: K)
' ==============================================================================

@startuml
title Sustav Pulsko – obrasci uporabe
left to right direction

skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #212529

skinparam actor {
    BackgroundColor #F8F9FA
    BorderColor #212529
    BackgroundColor<<external system>> #FFF3CD
    BorderColor<<external system>> #856404
}

skinparam usecase {
    BackgroundColor #E7F1FF
    BorderColor #0D6EFD
}

' ==============================================================================
' Primarni akteri
' ==============================================================================

actor User as "Korisnik"
actor Patient as "Pacijent"
actor Doctor as "Liječnik"
actor Admin as "Administrator"
actor Timer as "Timer"

' Pacijent i liječnik dijele prijavu i poruke preko nadaktera Korisnik.
Patient -|> User
Doctor -|> User

' ==============================================================================
' Sekundarni akteri (vanjski sustavi)
' ==============================================================================

actor "Pružatelj identiteta\n(OAuth 2.0)" as IdP <<external system>>
actor "AI usluga" as AI <<external system>>
actor "Usluga e-pošte" as Email <<external system>>

' ==============================================================================
' Granica sustava
' ==============================================================================

rectangle "Sustav Pulsko" as Pulsko {

    ' Zajedničko
    (UC-001\nPrijava u sustav) as UC_SignIn
    (UC-002\nRazmjena poruka\ns povezanom osobom) as UC_Messages

    ' Pacijent
    (UC-003\nSlanje zahtjeva za\npovezivanje s liječnikom) as UC_ConnectRequest
    (UC-004\nUnos dnevnog check-ina) as UC_CheckIn
    (UC-005\nPregled vlastitih\npodataka i trendova) as UC_Dashboard
    (UC-006\nUčitavanje\nlaboratorijskog nalaza) as UC_UploadLab
    (UC-007\nRazgovor s pacijentskim\nAI agentom) as UC_PatientAI
    (UC-017\nEvidentiranje\nuzimanja lijeka) as UC_DoseLog

    ' Liječnik
    (UC-008\nObrada zahtjeva\nza povezivanje) as UC_HandleRequest
    (UC-009\nPregled podataka\npacijenta) as UC_ViewPatient
    (UC-010\nPotvrda laboratorijskih\nvrijednosti) as UC_ConfirmLab
    (UC-011\nOdređivanje terapije\npacijentu) as UC_Therapy
    (UC-012\nZakazivanje termina\npregleda) as UC_Appointment
    (UC-013\nIzrada AI sažetka i\ndijeljenje s pacijentom) as UC_DoctorAI
    (UC-016\nProvjera povezanosti\ns pacijentom) as UC_CheckLink

    ' Administracija i vremenski okidači
    (UC-014\nOdobravanje\nliječničkog računa) as UC_ApproveDoctor
    (UC-015\nSlanje podsjetnika) as UC_Reminder
}

' ==============================================================================
' Asocijacije aktera i obrazaca uporabe
' ==============================================================================

User -- UC_SignIn
User -- UC_Messages

Patient -- UC_ConnectRequest
Patient -- UC_CheckIn
Patient -- UC_Dashboard
Patient -- UC_UploadLab
Patient -- UC_PatientAI
Patient -- UC_DoseLog

Doctor -- UC_HandleRequest
Doctor -- UC_ViewPatient
Doctor -- UC_ConfirmLab
Doctor -- UC_Therapy
Doctor -- UC_Appointment
Doctor -- UC_DoctorAI

Admin -- UC_ApproveDoctor
Timer -- UC_Reminder

' ==============================================================================
' Veze između obrazaca uporabe
' ==============================================================================

' Liječnik smije raditi samo s pacijentom koji je prihvatio povezivanje;
' provjera se uvijek izvodi.
UC_ViewPatient ..> UC_CheckLink : <<include>>
UC_ConfirmLab ..> UC_CheckLink : <<include>>
UC_Therapy ..> UC_CheckLink : <<include>>
UC_Appointment ..> UC_CheckLink : <<include>>
UC_DoctorAI ..> UC_CheckLink : <<include>>

' Prijava namjerno NIJE <<include>> ostalih obrazaca: korisnik je prijavljen
' prije njihova početka, pa je prijava preduvjet.

' ==============================================================================
' Interakcije sa sekundarnim akterima
' ==============================================================================

UC_SignIn -- IdP
UC_UploadLab -- AI
UC_PatientAI -- AI
UC_DoctorAI -- AI
UC_Reminder -- Email
@enduml
