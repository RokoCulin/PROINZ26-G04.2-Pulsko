' ==============================================================================
' 4-3-pulsko-domain-CD.puml
'
' Svrha:    Prikazuje domenski model i aplikacijske servise za temeljne tijekove
'           sustava Pulsko: registraciju korisnika i odobravanje liječnika
'           (UC-001, F-001, F-019), povezivanje pacijenta s liječnikom (UC-3,
'           UC-5.3, F-003) i dnevni check-in (UC-004, F-005, F-009). Agregati
'           User, DoctorPatientLink i DailyCheckin imaju dijelove prikazane
'           kompozicijom; servisi ovise o sučeljima repozitorija (trajnost je
'           apstrahirana). Slojevi su razdvojeni na aplikacijski i domenski.
' Autor:    Dora Marusevec, kolegij Programsko inženjerstvo
' AI:       Dijagram je izradio autor. AI je pomogao u reviziji i komentarima;
'           autor ih je pregledao i odgovara za konačni sadržaj.
' Praćenje: Model je polazište za implementaciju i odgovara kodu u
'           services/registration_service.py, services/doctor_service.py,
'           services/link_service.py, services/checkin_service.py,
'           models/user.py, models/link.py, models/message.py,
'           models/checkin.py, patient_access.py. Kad se dizajn promijeni
'           tijekom razvoja, ažurirati model; nazivi operacija su konceptualni.
'
' Diagram level: Structural / Domain Design
' Diagram type:  Class Diagram
' Version:       1.0
' ==============================================================================

@startuml
title Sustav Pulsko – domenski model (korisnici, povezivanje i check-in)

skinparam shadowing false
skinparam defaultFontName Arial
skinparam packageStyle rectangle
skinparam ArrowColor #212529

skinparam class {
    BackgroundColor #E7F1FF
    BorderColor #0D6EFD
}

skinparam note {
    BackgroundColor #F8F9FA
    BorderColor #212529
    FontColor #212529
}

' ==============================================================================
' Aplikacijski sloj: orkestrira slučajeve korištenja i delegira domeni.
' ==============================================================================
package "Aplikacijski sloj" {

  class RegistrationService <<ApplicationService>> {
    +register(): UUID
  }

  class DoctorApprovalService <<ApplicationService>> {
    +approve(): void
    +reject(): void
  }

  class LinkService <<ApplicationService>> {
    +request(): UUID
    +accept(): void
    +reject(): void
  }

  class CheckinService <<ApplicationService>> {
    +saveToday(): UUID
    +listRecent(): void
  }

}

' ==============================================================================
' Domenski sloj: sadrži poslovno stanje i pravila.
' ==============================================================================
package "Domenski sloj" {

  ' Agregati se međusobno referenciraju samo identifikatorom (patientId,
  ' doctorId, senderId, reviewedBy), a ne objektom. Profili i poruke su
  ' dijelovi agregata i prikazani su kompozicijom, a ne atributima.

  ' ------------------------------ Korisnik -----------------------------------
  class User <<Entity>> <<AggregateRoot>> {
    -id: UUID
    -oidcProvider: String
    -oidcSubject: String
    -email: String
    -displayName: String
    -role: Role
    -createdAt: DateTime
    -lastLoginAt: DateTime [0..1]
  }

  class PatientProfile <<Entity>> {
    -dateOfBirth: Date [0..1]
    -sex: String [0..1]
  }

  class DoctorProfile <<Entity>> {
    -institution: String
    -licenseNumber: String
    -approvalStatus: ApprovalStatus
    -reviewedBy: UUID [0..1]
    -reviewedAt: DateTime [0..1]
    -rejectionReason: String [0..1]
    +approve(adminId: UUID): void
    +reject(adminId: UUID, reason: String): void
  }

  enum Role {
    PATIENT
    DOCTOR
    ADMIN
  }

  enum ApprovalStatus {
    PENDING
    APPROVED
    REJECTED
  }

  ' ------------------- Veza pacijenta i liječnika ----------------------------
  class DoctorPatientLink <<Entity>> <<AggregateRoot>> {
    -id: UUID
    -patientId: UUID
    -doctorId: UUID
    -status: LinkStatus
    -requestedAt: DateTime
    -respondedAt: DateTime [0..1]
    +accept(): void
    +reject(): void
  }

  class Message <<Entity>> {
    -id: UUID
    -senderId: UUID
    -body: String
    -sentAt: DateTime
    -readAt: DateTime [0..1]
  }

  enum LinkStatus {
    PENDING
    ACCEPTED
    REJECTED
  }

  ' ----------------------------- Dnevni check-in -----------------------------
  class DailyCheckin <<Entity>> <<AggregateRoot>> {
    -id: UUID
    -patientId: UUID
    -checkinDate: Date
    -generalState: Integer [0..1]
    -sleepHours: Decimal [0..1]
    -steps: Integer [0..1]
    -heartRateBpm: Integer [0..1]
    -activityMinutes: Integer [0..1]
    -activityDescription: String [0..1]
    -createdAt: DateTime
    -updatedAt: DateTime
    +update(values): void
  }

  ' ------------------------------ Repozitoriji -------------------------------
  interface UserRepository <<Repository>> {
    +findById(id: UUID): User
    +findByIdentity(provider: String, subject: String): User
    +findApprovedDoctorByEmail(email: String): User
    +save(user: User): void
  }

  interface LinkRepository <<Repository>> {
    +findById(id: UUID): DoctorPatientLink
    +findActive(patientId: UUID, doctorId: UUID): DoctorPatientLink
    +findByDoctor(doctorId: UUID, status: LinkStatus): DoctorPatientLink [0..*]
    +findByPatient(patientId: UUID): DoctorPatientLink [0..*]
    +save(link: DoctorPatientLink): void
  }

  interface CheckinRepository <<Repository>> {
    +findByDate(patientId: UUID, date: Date): DailyCheckin
    +findRecent(patientId: UUID, limit: Integer): DailyCheckin [0..*]
    +save(checkin: DailyCheckin): void
  }

}

' ==============================================================================
' Veze i višestrukosti
' ==============================================================================

' Profili i poruke imaju smisla samo uz svoj korijen: životni ciklus im je
' vezan uz korijen (kompozicija). Korisnik ima profil prema svojoj ulozi.
User "1" *-- "0..1" PatientProfile : sadrži ►
User "1" *-- "0..1" DoctorProfile : sadrži ►
DoctorPatientLink "1" *-- "0..*" Message : sadrži ►

' Servisi ovise o sučeljima repozitorija, a ne o konkretnoj implementaciji.
RegistrationService ..> User : stvara ►
RegistrationService ..> UserRepository : učitava / sprema ►

DoctorApprovalService ..> User : mijenja profil liječnika ►
DoctorApprovalService ..> UserRepository : učitava / sprema ►

LinkService ..> DoctorPatientLink : stvara / mijenja ►
LinkService ..> LinkRepository : učitava / sprema ►
LinkService ..> UserRepository : traži odobrenog liječnika ►

CheckinService ..> DailyCheckin : stvara / mijenja ►
CheckinService ..> CheckinRepository : učitava / sprema ►

UserRepository ..> User : vraća / sprema ►
LinkRepository ..> DoctorPatientLink : vraća / sprema ►
CheckinRepository ..> DailyCheckin : vraća / sprema ►

' ==============================================================================
' Ograničenja
' ==============================================================================

note right of User
  Jedan Google račun (oidcProvider + oidcSubject)
  odgovara jednom korisniku i jednoj ulozi;
  duplikat se odbija (RegistrationConflict).
  Pri registraciji nastaje korisnik i profil prema
  ulozi (PATIENT ili DOCTOR); liječnik mora navesti
  ustanovu i broj licence (InvalidRegistration).
end note

note right of DoctorProfile
  Novi liječnik nastaje sa statusom PENDING.
  Dopušteni prijelazi stanja:
  - approve() : PENDING -> APPROVED
  - reject()  : PENDING -> REJECTED
                (sprema rejectionReason)
  APPROVED i REJECTED su završna stanja.
  Odobrava administrator; funkcije liječnika
  dostupne su samo odobrenom liječniku.
end note

note right of DoctorPatientLink
  Novi zahtjev nastaje sa statusom PENDING
  i vremenom zahtjeva.

  Dopušteni prijelazi stanja:
  - accept() : PENDING -> ACCEPTED
  - reject() : PENDING -> REJECTED
  ACCEPTED i REJECTED su završna stanja.

  Za par pacijent–liječnik smije postojati samo
  jedna aktivna veza (PENDING ili ACCEPTED).
  Liječnik smije čitati podatke pacijenta samo uz
  vezu u stanju ACCEPTED. Najveći broj pacijenata
  po liječniku provodi baza (okidač).
end note

note right of DailyCheckin
  Jedan check-in po pacijentu po danu (po
  hrvatskom vremenu); ponovno spremanje istog
  dana zamjenjuje vrijednosti. Dopušten je
  djelomičan unos, ali barem jedno polje mora
  biti uneseno. Rasponi: generalState 1–5,
  sleepHours 0–24, steps 0–100000,
  heartRateBpm 30–220, activityMinutes 0–1440;
  inače se unos odbija pogreškom.
end note

note bottom of LinkService
  request() smije izvesti pacijent, a accept() i
  reject() samo odobreni liječnik kojem je zahtjev
  upućen (tuđi zahtjev ponaša se kao nepostojeći).
  Provjera dopuštenja (uloga, odobrenje liječnika,
  CSRF) je u aplikacijskom sloju. Nazivi operacija
  su konceptualni (u kodu: LinkService.request()
  i respond(accept)).
end note

note bottom of UserRepository
  U kodu zasebna sučelja repozitorija još ne
  postoje: servisi koriste SQLAlchemy sesiju.
  Sučelja su konceptualna i apstrahiraju trajnost.
end note

@enduml